# Discord Developer Portal → your application → Bot → Reset Token / Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# Groq Console → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tavily dashboard → API Keys
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: use a single server for faster slash-command registration while testing.
# Remove this variable to register commands globally.
DISCORD_GUILD_ID=

# Render provides PORT automatically. Local default is 10000.
PORT=10000

# Optional tuning (defaults shown)
GROQ_TIMEOUT_MS=45000
TAVILY_TIMEOUT_MS=15000
MEMORY_TTL_MINUTES=360
MAX_CONVERSATIONS=1000
